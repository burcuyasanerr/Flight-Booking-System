# Bu dosyayı ".env" adıyla kopyalayıp kendi bilgilerinizi yazın.
# .env dosyası .gitignore'da olduğu için GitHub'a gitmez.

# PostgreSQL (backend, concurrency ve ticket_pdf ortak kullanır)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flight_booking
DB_USER=postgres
DB_PASSWORD=postgres

# Backend (FastAPI)
API_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Koltuk kilidi süresi (dakika) ve bir oturumun kilitleyebileceği en fazla koltuk
LOCK_DURATION_MINUTES=10
MAX_SEATS_PER_SESSION=9
